PORT=4000
DATABASE_URL=postgres://sumx:sumx@localhost:5432/sumx
JWT_SECRET=change-me-to-a-long-random-string
# Google Cloud Console > Credentials > OAuth client of type "Web application"
GOOGLE_WEB_CLIENT_ID=
# Mail (any SMTP provider). If SMTP_HOST is empty, codes are printed to the server console (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SUM X <no-reply@yourdomain.com>"
# Optional: GIF search (free key from Tenor / Google Cloud)
TENOR_API_KEY=
# Optional: TURN for calls behind strict NATs (coturn with static-auth-secret)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
UPLOAD_DIR=./uploads

# --- Email on hosts that block SMTP (Render free): use an HTTPS mail API. Pick ONE. ---
RESEND_API_KEY=
BREVO_API_KEY=
# If no mail provider is configured the server auto-verifies new accounts (dev/testing only).
# Database TLS is automatic for hosted DBs. PGSSL=false disables it, PGSSL=insecure skips certificate checks.
PGSSL=
